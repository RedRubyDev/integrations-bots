PORT=3010
NODE_ENV=production
REDIS_URL=redis://127.0.0.1:6379/1
BOT_SERVICE_API_KEY=
BOT_STORAGE_ENCRYPTION_KEY=
BOT_UPDATE_MODE=webhook
PUBLIC_BASE_URL=https://bots.your-domain.com
SHOP_BACKEND_URL_TEMPLATE=https://api.{domain}
TELEGRAM_API_BASE_URL=https://api.telegram.org
BALE_API_BASE_URL=https://tapi.bale.ai
# Optional HTTP CONNECT proxies (separate from provider API URLs).
TELEGRAM_PROXY_URL=
BALE_PROXY_URL=
BOT_SESSION_TTL_SECONDS=2592000
# BotFather tokens belong in the admin keys telegram.botKey and bale.botKey.
# BOT_SERVICE_API_KEY is the shared internal key, not a provider token.
# BOT_STORAGE_ENCRYPTION_KEY must be 64 hexadecimal characters.
